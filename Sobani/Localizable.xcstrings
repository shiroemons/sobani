      }
    },
    "update.hint.U-102": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubサーバーが一時的に不安定な可能性があります。しばらく待ってから再試行してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub servers may be temporarily unavailable. Please try again later."
          }
        }
      }
    },
    "update.hint.U-103": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらく待ってから再試行してください。繰り返す場合はGitHub Issuesで報告してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please try again later. If this persists, report it on GitHub Issues."
          }
        }
      }
    },
    "update.hint.U-201": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネット接続を確認し、再試行してください。VPN/プロキシ使用中は一時的に無効にしてみてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again. If using VPN/proxy, try disabling it temporarily."
          }
        }
      }
    },
    "update.hint.U-202": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの空き容量を確認してください。"
