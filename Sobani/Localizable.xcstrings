            "state": "translated",
            "value": "Purpose"
          }
        }
      }
    },
    "log.info.purpose.body": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の配置や復元に関する問題が発生した場合に、状況を把握・再現するためのデバッグ情報を記録します。開発者への問題報告時にこのログを提供していただくことで、問題の特定と修正に役立ちます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records debug information to help identify and reproduce issues with screen layout and window restoration. Sharing these logs with the developer helps diagnose and fix problems."
          }
        }
      }
    },
